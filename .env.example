# Environment-variable reference only. Never commit a populated .env file.
# AWS authentication comes from the EC2 instance profile, not static access keys.

# Secret override for local/temporary use; controllers should prefer the configured SSM parameter.
RUNPOD_API_KEY=

# Optional non-secret configuration overrides.
WAVCSE_INFRA_AWS_REGION=
WAVCSE_INFRA_CONFIG=
WAVCSE_INFRA_RUNPOD_API_KEY_PARAMETER=
WAVCSE_INFRA_RUNPOD_API_URL=
WAVCSE_INFRA_RUNPOD_CREATE_RECONCILE_ATTEMPTS=
WAVCSE_INFRA_RUNPOD_LIFECYCLE_TIMEOUT_SECONDS=
WAVCSE_INFRA_RUNPOD_MAX_POLL_INTERVAL_SECONDS=
WAVCSE_INFRA_RUNPOD_POLL_INTERVAL_SECONDS=
WAVCSE_INFRA_RUNPOD_TIMEOUT_SECONDS=
WAVCSE_INFRA_RUNPOD_READ_ATTEMPTS=
WAVCSE_INFRA_RUNPOD_RETRY_BACKOFF_SECONDS=
WAVCSE_INFRA_S3_BUCKET=
WAVCSE_INFRA_S3_PREFIX=
WAVCSE_INFRA_WAVCSE_PATH=
WAVCSE_INFRA_SSH_PRIVATE_KEY=
WAVCSE_INFRA_SSH_KNOWN_HOSTS_FILE=
WAVCSE_INFRA_SSH_CONNECT_TIMEOUT_SECONDS=
WAVCSE_INFRA_SSH_COMMAND_TIMEOUT_SECONDS=
WAVCSE_INFRA_SSH_BOOTSTRAP_TIMEOUT_SECONDS=
WAVCSE_INFRA_SSH_READINESS_TIMEOUT_SECONDS=
WAVCSE_INFRA_SSH_POLL_INTERVAL_SECONDS=
WAVCSE_INFRA_SSH_MAX_POLL_INTERVAL_SECONDS=
WAVCSE_INFRA_EXPECT_OMP=
WAVCSE_INFRA_MLFLOW_URL=

# Optional controller-bootstrap/agent-installer overrides. Normal installs use the
# reviewed repository pins; checksum overrides are required with OMP/AGF version changes.
WAVCSE_INFRA_CONTROLLER_USER=
WAVCSE_INFRA_OMP_VERSION=
WAVCSE_INFRA_OMP_X86_64_SHA256=
WAVCSE_INFRA_OMP_AARCH64_SHA256=
WAVCSE_INFRA_CODEX_VERSION=
WAVCSE_INFRA_AGF_VERSION=
WAVCSE_INFRA_AGF_X86_64_SHA256=
WAVCSE_INFRA_AGF_AARCH64_SHA256=
